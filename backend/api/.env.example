NODE_ENV=development
HOST=127.0.0.1
PORT=8787
DATABASE_URL=postgres://reverie:change-me@127.0.0.1:5432/reverie
JWT_SECRET=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_TTL_SECONDS=900
DEVELOPER_ACCOUNT_IDS=
# Separate, explicit authorization for financial-support character grants.
COMPENSATION_ADMIN_ACCOUNT_IDS=
CORS_ORIGIN=http://127.0.0.1:8060

# Stripe sandbox only. Never put live keys here or commit the real .env.
STRIPE_TEST_ENABLED=false
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=

# Explicit local-only manual verification, without webhook delivery.
STRIPE_TEST_MANUAL_RECONCILE=false

# Dedicated local sandbox payment review allowlist (comma-separated account UUIDs; empty denies access).
PAYMENT_REVIEW_ADMIN_ACCOUNT_IDS=
# Enable only on the Reverie public alpha host.
PUBLIC_ALPHA_MONITOR_ENABLED=0
