{
    "name": "reverie-online-api",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "generate:region-bounds": "node scripts/generate-region-bounds.mjs",
        "prebuild": "npm run generate:region-bounds",
        "pretest": "npm run generate:region-bounds",
        "pretypecheck": "npm run generate:region-bounds",
        "dev": "node --env-file=.env --import tsx --watch src/server.ts",
        "build": "tsc -p tsconfig.json",
        "test": "node --import tsx --test test/*.test.ts",
        "start": "node --env-file=.env dist/server.js",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test:e2e:persistent-world": "node --import tsx scripts/persistent-world-e2e.mjs",
        "test:e2e:dedicated-world": "node --import tsx scripts/dedicated-world-e2e.mjs",
        "test:e2e:eight-player": "node --env-file=.env --import tsx scripts/eight-player-reconnect-e2e.mjs",
        "test:e2e:cassien": "node --env-file=.env --import tsx scripts/cassien-ritual-e2e.mjs",
        "test:e2e:cassien-godot": "node --env-file=.env --import tsx scripts/cassien-godot-e2e.mjs",
        "test:e2e:story-combat": "node --env-file=.env --import tsx scripts/story-combat-service-e2e.mjs",
        "test:e2e:story-concurrency": "node --env-file=.env --import tsx scripts/story-combat-concurrency-e2e.mjs",
        "test:e2e:story-bosses": "node --env-file=.env --import tsx scripts/story-combat-boss-victory-e2e.mjs",
        "test:e2e:story-load": "node --env-file=.env --import tsx scripts/story-combat-load-e2e.mjs"
    },
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "@fastify/helmet": "^13.0.1",
        "@fastify/jwt": "^9.1.0",
        "@fastify/rate-limit": "^10.3.0",
        "@fastify/websocket": "^11.2.0",
        "argon2": "^0.44.0",
        "fastify": "^5.6.2",
        "pg": "^8.16.3",
        "stripe": "^23.2.0",
        "zod": "^4.1.12"
    },
    "devDependencies": {
        "@types/node": "^24.10.0",
        "@types/pg": "^8.15.5",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3"
    },
    "allowScripts": {
        "argon2@0.44.0": true,
        "esbuild@0.28.2": true
    }
}
