                      "zoom":  1.055,
                      "pan_x":  -7,
                      "pan_y":  0
                  },
                  {
                      "image":  "res://assets/cinematics/kael_prologue/images/18_kael_tearful_closeup.png",
                      "caption":  "I cannot remember your names. I cannot remember your faces. So why does my soul beg for your forgiveness?",
