extends Node
func _ready() -> void:
	var scene = load("res://scenes/world/tutorial_prologue/training_ground_v02.tscn").instantiate()
	add_child(scene)
	await get_tree().process_frame
	for i in range(3): scene._accept_challenge()
	scene._open_challenge()
	for i in range(4): scene._accept_challenge()
	scene._on_practice_hit(false)
	scene._on_practice_hit(false)
	scene._on_practice_hit(true)
	assert(scene.get_node("CompanionNPC").can_interact())
	scene.player.global_position = scene.get_node("CompanionNPC").global_position + Vector2(0, 40)
	scene.player.interaction_component.refresh_nearest()
	scene.player.try_interact()
	assert(scene.get_node("TutorialHUD/SparDialogue").visible)
	for i in range(3): scene._accept_challenge()
	await get_tree().create_timer(2.0).timeout
	var combat = scene.get_node("TutorialHUD/SparringRoot").get_child(0)
	assert(combat.engine.combatants.size() == 2)
	print("NPC DIALOGUE AND SPARRING PASS")
	scene._on_spar_result({"group_id": "tutorial_fairy_spar", "victory": false})
	scene._on_spar_closed()
	assert(scene.player.input_enabled and not scene.finishing)
	print("LOSS RETRY PASS")
	scene._on_spar_result({"group_id": "tutorial_fairy_spar", "victory": true})
	scene._on_spar_closed()
	assert(scene.farewell_pending and not scene.finishing and not scene.player.input_enabled)
	assert(scene.get_node("TutorialHUD/SparDialogue").visible)
	assert(not scene.player.has_node("FairyCompanion"))
	print("VICTORY FAREWELL AND NO EARLY FAIRY PASS")
	get_tree().quit()
