[sub_resource type="Shader" id="ArenaGrassKey"]
code = "shader_type canvas_item;\nvoid fragment() {\n\tvec4 texel = texture(TEXTURE, UV);\n\tfloat green_chroma = texel.g - max(texel.r, texel.b);\n\tfloat grass_background = smoothstep(0.22, 0.40, green_chroma) * smoothstep(0.60, 0.78, texel.g);\n\tCOLOR = vec4(texel.rgb, texel.a * (1.0 - grass_background));\n}\n"

