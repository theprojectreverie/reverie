[sub_resource type="Shader" id="Shader_courtyard_matte"]
code = "shader_type canvas_item;
render_mode unshaded;

void fragment() {
	vec4 art = COLOR;
	vec3 navy = vec3(20.0, 25.0, 52.0) / 255.0;
	art.a *= smoothstep(0.030, 0.067, distance(art.rgb, navy));
	COLOR = art;
}
"

