show_percentage = false

[node name="ProgressText" type="Label" parent="Row/Info"]
theme_override_font_sizes/font_size = 13

[node name="Reward" type="VBoxContainer" parent="Row"]
custom_minimum_size = Vector2(150, 0)
alignment = 1
theme_override_constants/separation = 8

[node name="Amount" type="Label" parent="Row/Reward"]
