[gd_scene format=3]

[node name="DailyQuestRow" type="PanelContainer"]
custom_minimum_size = Vector2(0, 100)
size_flags_horizontal = 3

[node name="Row" type="HBoxContainer" parent="."]
theme_override_constants/separation = 16

[node name="Info" type="VBoxContainer" parent="Row"]
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="Title" type="Label" parent="Row/Info"]
theme_override_font_sizes/font_size = 20

[node name="Description" type="Label" parent="Row/Info"]
autowrap_mode = 2

[node name="Progress" type="ProgressBar" parent="Row/Info"]
