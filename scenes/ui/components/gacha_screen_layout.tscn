[gd_scene load_steps=2 format=3]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_notice"]
bg_color = Color(0.086, 0.075, 0.149, 1)
border_color = Color(0.71, 0.55, 0.91, 0.35)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8
content_margin_left = 8.0
content_margin_top = 8.0
content_margin_right = 8.0
content_margin_bottom = 8.0

[node name="GachaScreenLayout" type="VBoxContainer"]
size_flags_vertical = 3
theme_override_constants/separation = 12

[node name="OfflineNotice" type="PanelContainer" parent="."]
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_notice")

[node name="ModeRow" type="HBoxContainer" parent="OfflineNotice"]
theme_override_constants/separation = 10
[node name="OnlineMode" type="CheckButton" parent="OfflineNotice/ModeRow"]
text = "Online summons"
[node name="OnlineRoster" type="Button" parent="OfflineNotice/ModeRow"]
visible = false
text = "Online collection"
[node name="History" type="Button" parent="OfflineNotice/ModeRow"]
text = "History"
custom_minimum_size = Vector2(80, 40)

[node name="NoticeText" type="Label" parent="OfflineNotice/ModeRow"]
size_flags_horizontal = 3
layout_mode = 2
theme_override_font_sizes/font_size = 11
theme_override_colors/font_color = Color(0.65, 0.68, 0.76, 1)
text = "Connecting to the online summon server..."
autowrap_mode = 3

[node name="PendingRecovery" type="Button" parent="."]
visible = false
custom_minimum_size = Vector2(0, 42)
text = "Retry interrupted summon"
tooltip_text = "Reuses the original request. If it was already processed, no additional currency is spent."

[node name="BannerTabs" type="HFlowContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Main" type="HBoxContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 16
