[gd_scene format=3]

[node name="PortraitGallery" type="VBoxContainer"]
visible = false
size_flags_vertical = 3
theme_override_constants/separation = 10

[node name="Toolbar" type="HBoxContainer" parent="."]
theme_override_constants/separation = 12

[node name="Search" type="LineEdit" parent="Toolbar"]
custom_minimum_size = Vector2(0, 44)
size_flags_horizontal = 3
placeholder_text = "Search character or rarity..."

[node name="Count" type="Label" parent="Toolbar"]
text = "0 portraits"
theme_override_colors/font_color = Color(0.91, 0.76, 0.48, 1)

[node name="Done" type="Button" parent="Toolbar"]
custom_minimum_size = Vector2(112, 44)
text = "Done"

[node name="Hint" type="Label" parent="."]
text = "Obtain characters to unlock their portraits. Select an unlocked portrait to preview it."

[node name="Scroll" type="ScrollContainer" parent="."]
size_flags_vertical = 3
horizontal_scroll_mode = 0
follow_focus = true

[node name="Grid" type="GridContainer" parent="Scroll"]
size_flags_horizontal = 3
columns = 5
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 10
